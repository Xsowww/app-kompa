# Configuration publique du projet (chargée automatiquement, les valeurs de .env ou de l'environnement gagnent).
# Supabase (projet cop-pilot) :
# La clé « publishable » est faite pour être visible dans le navigateur : la sécurité
# repose sur les règles de la base (Row Level Security). Ne mets JAMAIS de clé secrète ici.
VITE_SUPABASE_URL=https://deegcitkluyxukripeid.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_kHKvxcAxGoJaqHZbvjdhiA_4PdxAt-e

# Cloudflare Turnstile (anti-robot à la connexion) : la clé de SITE, publique. La clé secrète va
# seulement dans Supabase › Authentication › Attack Protection. Vide = pas de captcha.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFYWUeZT8ivyozn7

# IA de Copilot : le fournisseur n'est pas secret. La CLÉ (AI_API_KEY) ne va JAMAIS ici :
# mets-la en secret GitHub Codespaces / variable de l'hébergeur, ou dans .env (voir README).
AI_PROVIDER=groq

# Cloudflare Web Analytics (compteur de visites sans cookie) : le jeton du site, public (visible dans la page).
# Cloudflare › Web Analytics › kompaly.com › Manage site. Vide = pas de compteur.
CF_ANALYTICS_TOKEN=9131abe95bad42dfb3a566d8292abee7
