{
  "id": "/",
  "name": "Kompaly",
  "short_name": "Kompaly",
  "description": "Kompaly réunit ton agenda, tes tâches, tes notes et tes fichiers dans une seule appli gratuite, pour les études, le travail ou la vie perso.",
  "lang": "fr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ECEEF3",
  "theme_color": "#ECEEF3",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Nouvel événement", "url": "/calendrier?ajout=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Nouvelle tâche", "url": "/taches?ajout=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Nouvelle note", "url": "/notes?nouvelle=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Enregistrer un cours", "short_name": "Enregistrer", "url": "/enregistrer", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "/partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "fichiers", "accept": ["*/*", "image/*", "application/pdf", "text/*", "audio/*", "video/*", ".docx", ".pptx", ".xlsx", ".odt"] }]
    }
  },
  "screenshots": [
    { "src": "/og-image.png", "sizes": "1200x630", "type": "image/png", "form_factor": "wide", "label": "Kompaly : l’agenda, les tâches, les notes et les fichiers au même endroit" }
  ]
}
