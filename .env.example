# Copie ce fichier en .env puis remplis les valeurs. Ne jamais commiter .env.

# ── Assistant Kompaly intelligent (facultatif) ────────────────────────────────
# Sans IA configurée, Kompaly fonctionne en mode simple (commandes en français).
# Choisis UN fournisseur. La clé reste sur le serveur, jamais dans le navigateur.
#
#   AI_PROVIDER   anthropic | gemini | groq | openrouter | mistral | ollama | openai-compatible
#   AI_API_KEY    la clé du fournisseur (inutile pour ollama)
#   AI_MODEL      facultatif, sinon le modèle par défaut du fournisseur (entre parenthèses)
#   AI_BASE_URL   facultatif, sauf pour openai-compatible
#
# Gratuits (avec limites d'usage) :
#   gemini      (gemini-2.5-flash)  clé sur https://aistudio.google.com/apikey
#               Attention : en offre gratuite, Google peut utiliser les échanges pour améliorer ses modèles.
#   groq        (openai/gpt-oss-120b ; gratuit ≈ 1 000 requêtes/jour, 8 000 tokens/min)  clé sur https://console.groq.com/keys
#   openrouter  (meta-llama/llama-3.3-70b-instruct:free)  clé sur https://openrouter.ai/keys
#               (n'importe quel modèle dont le nom finit par « :free »)
#   mistral     (mistral-small-latest)  clé sur https://console.mistral.ai (offre « Experiment »)
#   ollama      (llama3.1)  100 % local et gratuit : https://ollama.com puis « ollama pull llama3.1 »
# Payant :
#   anthropic   (claude-opus-5-5)  clé sur https://console.anthropic.com
# Autre service compatible OpenAI (LM Studio, vLLM…) :
#   openai-compatible  avec AI_BASE_URL=http://…/v1 et AI_MODEL=…
#
# Exemple, Gemini gratuit :
#   AI_PROVIDER=gemini
#   AI_API_KEY=ta-cle
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Ancienne configuration, toujours acceptée : sans AI_PROVIDER, une clé Anthropic suffit.
ANTHROPIC_API_KEY=

# ── Base de données Supabase (facultatif) ────────────────────────────────────
# Supabase › Project Settings › API. Sans ces deux lignes, les comptes et les
# données restent enregistrés dans le navigateur (mode local).
# La clé « anon / publishable » peut être publique : la sécurité est assurée
# par les règles de supabase/schema.sql. N'utilise JAMAIS la clé secrète (service_role) dans une variable VITE_ :
# tout ce qui commence par VITE_ est visible dans le navigateur.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clé de site Cloudflare Turnstile (captcha à la connexion), facultative
VITE_TURNSTILE_SITE_KEY=
# 1 = captcha coupé côté site (période de tests ; le couper aussi dans Supabase)
VITE_CAPTCHA_OFF=

# Port du serveur de production (npm start)
PORT=3000

# ── Mise en ligne ────────────────────────────────────────────────────────────
# Adresse publique du site (sitemap.xml et robots.txt pour Google).
SITE_URL=
# 1 si l'hébergeur place le site derrière un proxy (Railway, Fly…) :
# les limites par adresse IP voient alors la vraie adresse de chaque visiteur.
# Automatique sur Render (0 pour le couper).
TRUST_PROXY=
# Questions par élève et par jour à Kompaly en mode intelligent (30 par défaut),
# et appels par jour pour tout le site (900 par défaut avec Groq).
AI_DAILY_QUESTIONS=
AI_DAILY_BUDGET=

# ── « Enregistrer un cours » : transcription du son (facultatif) ─────────────
# Avec AI_PROVIDER=groq, rien à ajouter : la même clé sert à Whisper (whisper-large-v3-turbo).
# Avec un autre fournisseur, une clé Groq suffit : https://console.groq.com/keys
#   (ou tout service compatible OpenAI /audio/transcriptions avec TRANSCRIBE_BASE_URL).
# Groq gratuit : environ 8 h de son par jour pour tout le site. En payant : environ 0,04 $ par heure de cours.
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=
# Minutes de son par élève et par jour (240 par défaut), et pour tout le site (450 par défaut avec Groq gratuit).
TRANSCRIBE_DAILY_MINUTES=
TRANSCRIBE_SITE_MINUTES=

# ── Rappels et notifications push (facultatif) ──────────────────────────────
# Sans ces deux lignes, les rappels s'affichent seulement quand Kompaly est ouvert.
# Après la migration supabase/migrations/2026-10-17_rappels.sql.
# PUSH_SECRET : une longue valeur au hasard (sur Render : « Generate »). La changer oblige
# chaque appareil à réactiver les notifications.
PUSH_SECRET=
# Clé SECRÈTE Supabase (Project Settings › API keys › secret key) : lit les rappels de
# tous les comptes pour les envoyer. Seulement sur le serveur, jamais dans une variable VITE_.
SUPABASE_SERVICE_ROLE_KEY=
